{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "functions/**/*.ts",
    "client/game/**/*.ts",
    "client/game/**/*.tsx",
    "client/src/components/DjMiniGame.tsx",
    "client/src/lib/**/*.ts",
    "server/arcadeLeaderboard.ts",
    "shared/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
